{"html": "<style>\n    :host {\n      color-scheme: light;\n      --navy: #101d2e;\n      --ink: #182a40;\n      --muted: #546477;\n      --line: #dbe3eb;\n      --canvas: #f1f4f8;\n      --white: #fff;\n      --gold: #bd934b;\n      --gold-ink: #755119;\n      --gold-light: #f8eedb;\n      font: 100%/1.5 system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    *, *::before, *::after { box-sizing: border-box; }\n    html { scroll-padding-bottom: 7rem; }\n    body { margin: 0; color: var(--ink); background: var(--canvas); }\n    h1, h2, h3, p, dl, dd { margin: 0; }\n    input, select, textarea, button { font: inherit; }\n    button, summary { cursor: pointer; }\n    button:disabled { cursor: wait; opacity: .65; }\n    a { color: inherit; }\n    :focus-visible { outline: 3px solid #98691d; outline-offset: 3px; }\n    [hidden] { display: none !important; }\n\n    .appbar { background: var(--navy); color: var(--white); border-bottom: 2px solid var(--gold); }\n    .appbar-inner, .workspace { max-width: 1320px; margin: auto; padding-inline: 28px; }\n    .appbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }\n    .app-brand { display: flex; align-items: center; gap: 12px; }\n    .app-mark {\n      display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #725c38;\n      border-radius: 9px; background: #263144; color: #f2d59a;\n    }\n    .app-brand strong, .app-brand small { display: block; letter-spacing: .12em; }\n    .app-brand strong { font-size: .83rem; }\n    .app-brand small { color: #e5c37d; font-size: .63rem; font-weight: 700; }\n    .app-context { color: #b7c4d4; font-size: .78rem; font-weight: 600; }\n\n    .workspace { padding-block: 32px 60px; }\n    .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(310px, 340px); align-items: start; gap: 20px; margin-bottom: 24px; }\n    .eyebrow { color: var(--gold-ink); font-size: .73rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }\n    h1 { margin-block: 4px 6px; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -.045em; line-height: 1.12; }\n    .intro-copy > p:last-of-type { color: var(--muted); font-size: .94rem; }\n    .jump-link { display: none; }\n\n    .sequence-card {\n      padding: 14px 16px; border: 1px solid #e7d6b6; border-left: 3px solid var(--gold);\n      border-radius: 12px; background: #fffbf4;\n    }\n    .sequence-display { display: flex; gap: 8px 14px; justify-content: space-between; align-items: center; flex-wrap: wrap; }\n    .sequence-caption { font-size: .75rem; font-weight: 700; }\n    .sequence-number {\n      font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 1.05rem;\n      font-weight: 750; color: var(--gold-ink); font-variant-numeric: tabular-nums;\n    }\n    .sequence-hint { color: var(--muted); font-size: .77rem; margin-block: 3px 4px; }\n    .sequence-settings summary { width: fit-content; min-height: 32px; padding-block: 6px; color: var(--gold-ink); font-size: .79rem; font-weight: 700; }\n    .sequence-settings[open] summary { margin-bottom: 8px; }\n    .sequence-form { border-top: 1px solid #e7d6b6; padding-top: 10px; }\n    .sequence-form .hint { margin: 0 0 10px; }\n    .sequence-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: start; }\n    .feedback { color: #8e271d; margin-top: 8px; font-size: .8rem; font-weight: 650; }\n\n    .editor-layout { display: grid; grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); align-items: start; gap: 24px; }\n    .editor, .preview {\n      min-width: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--white);\n      box-shadow: 0 10px 28px #101d2e0a;\n    }\n    .panel-head {\n      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 12px;\n      padding: 17px 22px; border-bottom: 1px solid var(--line);\n    }\n    .panel-head h2 { font-size: 1.02rem; font-weight: 750; letter-spacing: -.015em; }\n    .panel-tag {\n      padding: 3px 8px; border: 1px solid var(--line); border-radius: 5px;\n      color: var(--muted); font-size: .72rem; font-weight: 650; white-space: nowrap;\n    }\n    .invoice-fields { min-width: 0; margin: 0; padding: 0; border: 0; }\n    .form-section { display: grid; gap: 12px; padding: 19px 22px 20px; }\n    .form-section + .form-section { border-top: 1px solid var(--line); }\n    .section-title { display: flex; align-items: center; gap: 9px; font-size: .91rem; font-weight: 750; }\n    .section-number {\n      display: grid; place-items: center; width: 29px; height: 29px; border-radius: 7px;\n      background: var(--gold-light); color: var(--gold-ink); font-size: .69rem; font-weight: 750;\n    }\n    .field-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n    .field { min-width: 0; }\n    label { display: block; margin-bottom: 5px; font-size: .8rem; font-weight: 650; }\n    input, textarea, select {\n      display: block; width: 100%; min-width: 0; min-height: 44px; padding: 8px 10px;\n      border: 1px solid #cbd7e2; border-radius: 8px; color: var(--ink); background: var(--white);\n    }\n    input::placeholder, textarea::placeholder { color: #67778a; opacity: 1; }\n    input::-webkit-date-and-time-value { text-align: left; }\n    textarea { min-height: 76px; resize: vertical; }\n    .hint { margin-top: 5px; color: var(--muted); font-size: .76rem; }\n\n    .action-bar {\n      position: sticky; bottom: 0; z-index: 1; padding: 14px 22px;\n      border-top: 1px solid var(--line); border-radius: 0 0 16px 16px; background: #f8fafc;\n    }\n    .action-inner, .action-buttons { display: flex; align-items: center; gap: 8px; }\n    .action-inner { justify-content: space-between; flex-wrap: wrap; }\n    .action-total span { display: block; color: var(--muted); font-size: .71rem; font-weight: 650; }\n    .action-total strong { display: block; font-size: 1.13rem; font-variant-numeric: tabular-nums; white-space: nowrap; }\n    .button {\n      display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px;\n      padding: 8px 12px; border: 1px solid transparent; border-radius: 8px; font-size: .83rem;\n      font-weight: 750; line-height: 1.2; white-space: nowrap; text-decoration: none;\n    }\n    .button svg { flex: none; }\n    .button-primary { color: var(--white); background: var(--navy); }\n    .button-primary:hover { background: #263b55; }\n    .button-quiet { color: var(--ink); border-color: #cbd7e2; background: var(--white); }\n    .button-quiet:hover { background: var(--canvas); }\n    .pdf-help { margin-top: 8px; color: var(--muted); font-size: .74rem; }\n    .pdf-actions {\n      display: flex; align-items: center; flex-wrap: wrap; gap: 2px 14px;\n      margin-top: 6px; color: var(--muted); font-size: .79rem;\n    }\n    .pdf-actions span { color: #1f6045; font-weight: 750; }\n    .pdf-actions a, .pdf-actions button {\n      display: inline-flex; align-items: center; min-height: 44px; padding: 0; border: 0;\n      color: var(--ink); background: transparent; font-weight: 700; text-decoration: underline; text-underline-offset: 3px;\n    }\n\n    .preview { overflow: hidden; }\n    .preview-head { background: var(--white); }\n    .preview-pad { padding: clamp(14px, 2.2vw, 28px); background: #e8eef5; }\n    .paper {\n      padding: clamp(24px, 3vw, 42px); background: var(--white); border: 1px solid #d8e2ee;\n      border-radius: 8px; box-shadow: 0 6px 18px #101d2e12; overflow-wrap: anywhere;\n      font-size: .84rem;\n    }\n    .invoice-header {\n      display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;\n      padding-block: 17px 20px; border-top: 4px solid var(--gold); border-bottom: 1px solid var(--line);\n    }\n    .invoice-brand { display: flex; align-items: center; min-width: 0; gap: 10px; }\n    .brand-logo { width: 68px; height: auto; flex: none; }\n    .brand-name strong { display: block; font-size: .82rem; letter-spacing: .055em; line-height: 1.3; }\n    .brand-name span { display: block; margin-top: 4px; color: var(--muted); font-size: .69rem; }\n    .invoice-id { text-align: right; flex: none; }\n    .invoice-id strong { display: block; font-size: 1.7rem; letter-spacing: -.045em; line-height: 1.15; }\n    .invoice-id span { display: block; margin-top: 5px; color: var(--gold-ink); font-size: .82rem; font-weight: 750; font-variant-numeric: tabular-nums; }\n    .invoice-id [data-draft=\"true\"] { color: var(--muted); }\n\n    .invoice-details {\n      display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px; margin-top: 18px;\n      padding: 13px 14px; border: 1px solid var(--line); border-radius: 8px; background: #f5f8fb;\n    }\n    .paper-kicker { color: var(--muted); font-size: .68rem; font-weight: 750; letter-spacing: .075em; text-transform: uppercase; }\n    .client-name { margin-top: 3px; font-size: .98rem; font-weight: 750; }\n    .client-detail { color: var(--muted); font-size: .78rem; }\n    .invoice-meta { display: grid; grid-template-columns: auto auto; align-items: center; gap: 4px 10px; font-size: .75rem; }\n    .invoice-meta dt { color: var(--muted); }\n    .invoice-meta dd { text-align: right; font-weight: 650; font-variant-numeric: tabular-nums; }\n    .invoice-status {\n      display: inline-block; padding: 2px 7px; border: 1px solid #e4c991; border-radius: 5px;\n      background: #fff4df; color: #6e480f; font-size: .69rem; font-weight: 750;\n    }\n    .invoice-status[data-status=\"paid\"] { border-color: #a4d6bd; background: #e8f7ee; color: #185a3b; }\n    .invoice-status[data-status=\"cancelled\"] { border-color: #e7b8b4; background: #fbebea; color: #882c28; }\n\n    .charges-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-block: 22px 8px; }\n    .charges-heading h3 { font-size: .91rem; font-weight: 750; }\n    .charges-heading span { color: var(--muted); font-size: .71rem; }\n    .charges { width: 100%; border-collapse: collapse; }\n    .charges th, .charges td { padding: 9px 10px; text-align: left; vertical-align: top; }\n    .charges th { background: var(--navy); color: var(--white); font-size: .73rem; font-weight: 650; }\n    .charges td { border-bottom: 1px solid var(--line); }\n    .charges :is(th, td):last-child { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }\n    .charges td:last-child { font-weight: 700; }\n    .item-name { display: block; font-weight: 700; }\n    .item-detail { display: block; color: var(--muted); font-size: .74rem; }\n    .credit { color: #1f6045; }\n    .courtesy { color: var(--gold-ink); font-size: .72rem; }\n\n    .totals { width: min(100%, 255px); margin: 14px 0 0 auto; }\n    .totals-row { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0; }\n    .totals-row strong { white-space: nowrap; font-variant-numeric: tabular-nums; }\n    .total-box {\n      align-items: center; margin-top: 6px; padding: 10px 12px; border: 1px solid #e7d6b6;\n      border-radius: 7px; background: var(--gold-light);\n    }\n    .total-box span { font-size: .75rem; font-weight: 750; }\n    .total-box strong { font-size: 1.1rem; }\n    .invoice-foot {\n      display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: 16px; margin-top: 22px;\n      padding-top: 13px; border-top: 1px solid var(--line);\n    }\n    .invoice-foot p { margin-top: 4px; font-size: .78rem; white-space: pre-wrap; }\n    .paper-end {\n      display: flex; justify-content: space-between; gap: 8px; margin-top: 24px; padding-top: 10px;\n      border-top: 1px solid var(--line); color: var(--muted); font-size: .68rem;\n    }\n    .paper-end strong { color: var(--ink); }\n\n    @media screen and (max-width: 920px) {\n      .appbar-inner, .workspace { max-width: 660px; padding-inline: 16px; }\n      .workspace { padding-block: 24px calc(148px + env(safe-area-inset-bottom)); }\n      .intro { grid-template-columns: 1fr; gap: 14px; margin-bottom: 16px; }\n      .intro-copy > p:last-of-type { font-size: .88rem; }\n      .jump-link { display: inline-flex; align-items: center; min-height: 44px; font-size: .84rem; font-weight: 750; text-underline-offset: 3px; }\n      .editor-layout { grid-template-columns: minmax(0, 1fr); gap: 18px; }\n      .editor, .preview { scroll-margin-top: 12px; }\n      .panel-head, .form-section { padding-inline: 16px; }\n      .sequence-settings summary { min-height: 44px; padding-block: 11px; }\n      .action-bar {\n        position: fixed; z-index: 2; inset: auto 0 0; padding: 10px max(12px, env(safe-area-inset-right))\n          calc(10px + env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));\n        border-radius: 0; box-shadow: 0 -3px 14px #101d2e12;\n      }\n      .action-inner, .action-bar > p, .pdf-actions { max-width: 628px; margin-inline: auto; }\n      .action-total strong { font-size: clamp(.9rem, 4vw, 1.12rem); }\n      .action-buttons .button { padding-inline: 9px; }\n      .pdf-help { display: none; }\n    }\n\n    @media screen and (max-width: 470px) {\n      .appbar-inner { min-height: 58px; }\n      .app-context { font-size: .72rem; }\n      .panel-head { padding-block: 13px; }\n      .form-section { padding-block: 15px 17px; }\n      .preview-pad { padding: 9px; }\n      .paper { padding: 15px 12px; font-size: .78rem; }\n      .brand-logo { width: 43px; }\n      .invoice-brand { gap: 6px; }\n      .brand-name strong { font-size: .68rem; }\n      .brand-name span { font-size: .62rem; }\n      .invoice-id strong { font-size: 1.28rem; }\n      .invoice-id span { font-size: .73rem; }\n      .invoice-details, .invoice-foot { grid-template-columns: minmax(0, 1fr); gap: 8px; }\n      .invoice-meta { justify-content: space-between; }\n      .charges th, .charges td { padding-inline: 7px; }\n      .paper-end { flex-wrap: wrap; }\n      .action-buttons { gap: 5px; }\n      .action-buttons .button { font-size: .78rem; }\n      .action-buttons .button-quiet svg { display: none; }\n      .new-label { display: none; }\n    }\n\n    @page { size: letter; margin: .55in .62in; }\n    @media print {\n      html, body { background: white; print-color-adjust: exact; -webkit-print-color-adjust: exact; }\n      .appbar, .intro, .editor, .preview-head { display: none !important; }\n      .workspace, .editor-layout, .preview, .preview-pad { display: block; margin: 0; padding: 0; max-width: none; }\n      .preview, .paper { border: 0; border-radius: 0; box-shadow: none; overflow: visible; }\n      .preview-pad { background: white; }\n      .paper { padding: 0; font-size: 10pt; }\n      .invoice-header, .invoice-details, .totals, .paper-end, tr { break-inside: avoid; }\n      .charges-heading { break-after: avoid; }\n    }\n  \n:host{display:block;--ink:var(--cyber-ui-ink,#e9effa);--muted:var(--cyber-ui-muted,#9eacc0);--line:var(--cyber-ui-border,#344055);--canvas:transparent;--white:var(--cyber-ui-panel,#192232);--navy:var(--trader-accent,#e72a3e);--gold:var(--trader-accent,#e72a3e);--gold-ink:var(--trader-accent-ink,#ff8192);--gold-light:color-mix(in srgb,var(--trader-accent,#e72a3e) 12%,transparent);font:calc(13px * var(--trader-font-scale,1))/1.6 var(--font-mono,ui-monospace,SFMono-Regular,Menlo,Consolas,monospace);color:var(--ink);color-scheme:inherit}\n.workspace{padding:0;max-width:none}.intro{grid-template-columns:minmax(0,1fr) auto;gap:14px;margin-bottom:18px}.intro h1{font-size:22px}.intro-copy>p:last-of-type{font-size:12px;max-width:46ch}.intro .eyebrow{display:none}.sequence-card{border-color:var(--line);background:var(--gold-light);max-width:300px;padding:12px 16px}.sequence-hint{font-size:11px}.editor-layout{gap:16px;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.editor,.preview{box-shadow:none;border-radius:12px}.panel-head,.form-section{padding:16px}.panel-head h2{font-size:13px}.section-title{font-size:12px}input,textarea,select{border-color:var(--line);font-size:14px}input::placeholder,textarea::placeholder{color:var(--muted)}.hint{font-size:11px}.action-bar{position:static;padding:16px;background:var(--white)}.action-buttons{flex-wrap:wrap}.button{white-space:normal;font-size:12px}.button-primary{background:var(--trader-accent,#e72a3e);color:var(--trader-accent-on,#fff)}.button-primary:hover{filter:brightness(1.12);background:var(--trader-accent,#e72a3e)}.button-quiet{border-color:var(--line)}.button-quiet:hover{background:var(--gold-light)}.feedback{color:var(--ink)}.pdf-actions span{color:var(--ink)}.preview-pad{background:#dfe5ed;padding:12px}.paper{--ink:#182a40;--muted:#546477;--line:#dbe3eb;--white:#fff;--gold-ink:#755119;--navy:#101d2e;--gold-light:#f8eedb;color:var(--ink);font-family:var(--font-mono,ui-monospace,monospace)}.paper .invoice-id strong{font-size:1.4rem}.paper .invoice-id span{font-size:.68rem}.paper .invoice-meta{font-size:.66rem}.paper .brand-name{font-size:.7rem}.paper .brand-tagline{font-size:.6rem}.preview-head .jump-link{color:var(--ink)}.jump-link{color:var(--gold-ink)}\n@media(max-width:1000px){.editor-layout{grid-template-columns:1fr}.intro{grid-template-columns:1fr}.sequence-card{max-width:none}.jump-link{display:inline-flex;align-items:center;min-height:44px;font-size:12px}.preview{max-width:none}.action-bar{position:static}}@media(max-width:480px){.field-grid{grid-template-columns:1fr}.form-section,.panel-head{padding:14px}.paper{padding:18px 14px}.invoice-details{grid-template-columns:1fr}.action-inner{align-items:flex-start}.action-buttons{width:100%}.action-buttons>.button{flex:1}.intro h1{font-size:20px}.intro-copy>p:last-of-type{font-size:11px}}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}\n@media(max-width:600px){input,textarea,select{font-size:16px}}\n</style>\n<main class=\"workspace\">\n    <div class=\"intro\">\n      <div class=\"intro-copy\">\n        <p class=\"eyebrow\">Facturación</p>\n        <h1>Nueva factura</h1>\n        <p>Completa los datos y revisa el documento antes de generar el PDF.</p>\n        <a class=\"jump-link\" href=\"#preview\">Ver vista previa ↓</a>\n      </div>\n      <aside class=\"sequence-card\" aria-label=\"Numeración de facturas\">\n        <div class=\"sequence-display\" aria-live=\"polite\">\n          <span class=\"sequence-caption\" id=\"sequenceCaption\">Serie del portal</span>\n          <strong class=\"sequence-number\" id=\"sequenceNumber\">—</strong>\n        </div>\n        <p class=\"sequence-hint\" id=\"sequenceHint\">El número se asigna al guardar la factura.</p>\n        \n      </aside>\n    </div>\n\n    <div class=\"editor-layout\">\n      <section class=\"editor\" id=\"editor\" aria-labelledby=\"editorHeading\">\n        <div class=\"panel-head\">\n          <h2 id=\"editorHeading\">Datos de la factura</h2>\n          <span class=\"panel-tag\">USD</span>\n        </div>\n        <form id=\"invoiceForm\">\n          <fieldset class=\"invoice-fields\" id=\"invoiceFields\">\n            <section class=\"form-section\" aria-labelledby=\"clientHeading\">\n              <h3 class=\"section-title\" id=\"clientHeading\"><span class=\"section-number\" aria-hidden=\"true\">01</span> Cliente y fechas</h3>\n              <div class=\"field\">\n                <label for=\"client\">Nombre del cliente</label>\n                <input id=\"client\" maxlength=\"110\" placeholder=\"Nombre completo\" required>\n              </div>\n              <div class=\"field\">\n                <label for=\"detail\">Correo o teléfono <span class=\"hint\">(opcional)</span></label>\n                <input id=\"detail\" maxlength=\"130\" placeholder=\"Datos de contacto\">\n              </div>\n              <div class=\"field-grid\">\n                <div class=\"field\">\n                  <label for=\"issueDate\">Fecha de emisión</label>\n                  <input id=\"issueDate\" type=\"date\" required>\n                </div>\n                <div class=\"field\">\n                  <label for=\"dueDate\">Fecha de vencimiento</label>\n                  <input id=\"dueDate\" type=\"date\">\n                </div>\n              </div>\n              <div class=\"field\">\n                <label for=\"status\">Estado</label>\n                <select id=\"status\">\n                  <option value=\"pending\">Pendiente</option>\n                  <option value=\"paid\">Pagada</option>\n                  <option value=\"cancelled\">Anulada</option>\n                </select>\n              </div>\n            </section>\n\n            <section class=\"form-section\" aria-labelledby=\"serviceHeading\">\n              <h3 class=\"section-title\" id=\"serviceHeading\"><span class=\"section-number\" aria-hidden=\"true\">02</span> Servicio y descuento</h3>\n              <div class=\"field\">\n                <label for=\"service\">Descripción del servicio</label>\n                <input id=\"service\" maxlength=\"150\" placeholder=\"Ej. Curso intensivo de trading\" required>\n              </div>\n              <div class=\"field-grid\">\n                <div class=\"field\">\n                  <label for=\"price\">Precio regular (USD)</label>\n                  <input id=\"price\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100000000\" step=\".01\" placeholder=\"0.00\" required>\n                </div>\n                <div class=\"field\">\n                  <label for=\"discount\">Descuento (%)</label>\n                  <input id=\"discount\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100\" step=\".01\" value=\"0\">\n                </div>\n              </div>\n              <div class=\"field\">\n                <label for=\"discountLabel\">Concepto del descuento <span class=\"hint\">(opcional)</span></label>\n                <input id=\"discountLabel\" maxlength=\"80\" placeholder=\"Ej. Promoción especial\">\n              </div>\n            </section>\n\n            <section class=\"form-section\" aria-labelledby=\"benefitHeading\">\n              <h3 class=\"section-title\" id=\"benefitHeading\"><span class=\"section-number\" aria-hidden=\"true\">03</span> Cortesía</h3>\n              <div class=\"field\">\n                <label for=\"benefit\">Beneficio incluido <span class=\"hint\">(opcional)</span></label>\n                <input id=\"benefit\" maxlength=\"130\" placeholder=\"Ej. 1 mes de acceso VIP\">\n              </div>\n              <div class=\"field\">\n                <label for=\"benefitValue\">Valor de referencia (USD)</label>\n                <input id=\"benefitValue\" type=\"number\" inputmode=\"decimal\" min=\"0\" max=\"100000000\" step=\".01\" placeholder=\"0.00\" aria-describedby=\"benefitHint\">\n                <p class=\"hint\" id=\"benefitHint\">El beneficio se muestra como cortesía y el total a pagar queda igual.</p>\n              </div>\n            </section>\n\n            <section class=\"form-section\" aria-labelledby=\"paymentHeading\">\n              <h3 class=\"section-title\" id=\"paymentHeading\"><span class=\"section-number\" aria-hidden=\"true\">04</span> Pago y notas</h3>\n              <div class=\"field\">\n                <label for=\"paymentMethods\">Métodos aceptados</label>\n                <input id=\"paymentMethods\" maxlength=\"140\" value=\"PayPal · ATH Móvil\">\n              </div>\n              <div class=\"field\">\n                <label for=\"paymentDetails\">Datos para pagar <span class=\"hint\">(opcional)</span></label>\n                <input id=\"paymentDetails\" maxlength=\"200\" placeholder=\"Cuenta PayPal o número de ATH Móvil\">\n              </div>\n              <div class=\"field\">\n                <label for=\"notes\">Notas para el cliente <span class=\"hint\">(opcional)</span></label>\n                <textarea id=\"notes\" maxlength=\"600\" placeholder=\"Detalles o instrucciones para el cliente\"></textarea>\n              </div>\n            </section>\n\n          </fieldset>\n          <div class=\"action-bar\">\n            <div class=\"action-inner\">\n              <div class=\"action-total\"><span>Total a pagar</span><strong id=\"actionTotal\">$0.00</strong></div>\n              <div class=\"action-buttons\">\n                <button type=\"button\" class=\"button button-quiet\" id=\"newButton\" aria-label=\"Nueva factura\">\n                  <svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M8 3v10M3 8h10\"/></svg>\n                  <span>Nueva<span class=\"new-label\"> factura</span></span>\n                </button>\n                <button type=\"submit\" class=\"button button-primary\" id=\"pdfButton\" aria-describedby=\"pdfHelp\" disabled>\n                  <svg width=\"15\" height=\"15\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v8m-3-3 3 3 3-3M3 11v3h10v-3\"/></svg>\n                  <span id=\"pdfButtonLabel\">Guardar y generar PDF</span>\n                </button>\n                <a class=\"button button-primary\" id=\"downloadPdf\" download hidden>Descargar PDF</a>\n              </div>\n            </div>\n            <p class=\"pdf-help\" id=\"pdfHelp\">Guarda la factura y luego toca Descargar PDF. También puedes abrirla o compartirla desde el celular.</p>\n            <div class=\"pdf-actions\" id=\"pdfActions\" hidden>\n              <span role=\"status\">PDF listo</span>\n              <a id=\"openPdf\" target=\"_blank\" rel=\"noopener\">Abrir PDF</a>\n              <button type=\"button\" id=\"sharePdf\" hidden>Compartir PDF</button>\n            </div>\n            <p class=\"feedback\" id=\"invoiceFeedback\" role=\"status\" hidden></p>\n          </div>\n        </form>\n      </section>\n\n      <section class=\"preview\" id=\"preview\" aria-labelledby=\"previewHeading\">\n        <div class=\"panel-head preview-head\">\n          <h2 id=\"previewHeading\">Vista previa</h2>\n          <a class=\"jump-link\" href=\"#editor\">Volver al editor ↑</a>\n          <span class=\"panel-tag\">Formato carta</span>\n        </div>\n        <div class=\"preview-pad\">\n          <article class=\"paper\" aria-label=\"Factura de OLON Society Academy\">\n            <header class=\"invoice-header\">\n              <div class=\"invoice-brand\">\n                <img class=\"brand-logo\" src=\"./billing/logo.png\" alt=\"\" width=\"609\" height=\"650\">\n                <div class=\"brand-name\">\n                  <strong>OLON SOCIETY<br>ACADEMY</strong>\n                  <span>Educación · Trading · Mentoría</span>\n                </div>\n              </div>\n              <div class=\"invoice-id\">\n                <strong>Factura</strong>\n                <span id=\"viewNumber\" data-draft=\"true\">Borrador</span>\n              </div>\n            </header>\n\n            <div class=\"invoice-details\">\n              <div>\n                <p class=\"paper-kicker\">Facturar a</p>\n                <p class=\"client-name\" id=\"viewClient\">Nombre del cliente</p>\n                <p class=\"client-detail\" id=\"viewDetail\" hidden></p>\n              </div>\n              <dl class=\"invoice-meta\">\n                <dt>Emisión</dt><dd id=\"viewIssueDate\">—</dd>\n                <dt id=\"dueLabel\" hidden>Vencimiento</dt><dd id=\"viewDueDate\" hidden></dd>\n                <dt>Estado</dt><dd><span class=\"invoice-status\" id=\"viewStatus\">Pendiente</span></dd>\n              </dl>\n            </div>\n\n            <div class=\"charges-heading\"><h3>Detalle de servicios</h3><span>Moneda USD</span></div>\n            <table class=\"charges\" aria-label=\"Desglose de cargos\">\n              <thead><tr><th scope=\"col\">Descripción</th><th scope=\"col\">Importe</th></tr></thead>\n              <tbody>\n                <tr><td><span class=\"item-name\" id=\"viewService\">Descripción del servicio</span></td><td id=\"viewPrice\">$0.00</td></tr>\n                <tr id=\"discountRow\" hidden>\n                  <td><span class=\"item-name\" id=\"viewDiscountLabel\">Descuento aplicado</span><span class=\"item-detail\" id=\"viewDiscountPct\"></span></td>\n                  <td class=\"credit\" id=\"viewDiscountValue\"></td>\n                </tr>\n                <tr id=\"benefitRow\" hidden>\n                  <td><span class=\"item-name\" id=\"viewBenefit\"></span><span class=\"item-detail\">Valor de referencia <span id=\"viewBenefitValue\"></span></span></td>\n                  <td class=\"courtesy\">Incluido</td>\n                </tr>\n              </tbody>\n            </table>\n\n            <div class=\"totals\">\n              <div class=\"totals-row\"><span>Precio regular</span><strong id=\"viewSubtotal\">$0.00</strong></div>\n              <div class=\"totals-row\" id=\"totalDiscountRow\" hidden><span>Descuento</span><strong class=\"credit\" id=\"viewTotalDiscount\"></strong></div>\n              <div class=\"totals-row total-box\"><span>Total a pagar</span><strong id=\"viewTotal\">$0.00</strong></div>\n            </div>\n\n            <div class=\"invoice-foot\" id=\"invoiceFoot\">\n              <div id=\"paymentSection\">\n                <h3 class=\"paper-kicker\">Métodos de pago</h3>\n                <p id=\"viewPaymentMethods\">PayPal · ATH Móvil</p>\n                <p id=\"viewPaymentDetails\" hidden></p>\n              </div>\n              <div id=\"notesSection\" hidden>\n                <h3 class=\"paper-kicker\">Notas</h3>\n                <p id=\"viewNotes\"></p>\n              </div>\n            </div>\n            <footer class=\"paper-end\"><strong>OLON Society Academy</strong><span>Gracias por tu confianza</span></footer>\n          </article>\n        </div>\n      </section>\n    </div>\n  </main>"}